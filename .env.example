# Copy this file to .env, then replace each placeholder with your own values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the publishable/anon key only. Never put a secret or service_role key here.
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: Groq powers AI chat, plan wording, and the warm voice-note summaries.
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional model override; leave blank to use the app's configured defaults.
GROQ_MODEL=

# Local screening model folder and debug detail setting.
MODEL_DIR=models
CARECOMPASS_DEBUG=0
